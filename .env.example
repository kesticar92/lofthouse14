NEXT_PUBLIC_SITE_URL=https://www.lofthouse14.com

# WhatsApp / teléfono público: fijo en src/lib/site.ts (+573181585801)
NEXT_PUBLIC_EMAIL=lofthouse14cali@gmail.com

# --- Analytics / marketing (opcionales) ---
NEXT_PUBLIC_GA_ID=G-R9M0QWD1H3
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity (auditoría #34) — solo carga tras consentimiento
NEXT_PUBLIC_CLARITY_ID=
# Hotjar site id (auditoría #34)
NEXT_PUBLIC_HOTJAR_ID=

# --- Supabase (Auth del panel + datos futuros) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave publishable (sb_publishable_…) o anon legacy (eyJ…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Si solo tienes anon:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin local (sin Supabase) ---
# Si faltan las vars públicas de Supabase, el login en /admin/login
# acepta credenciales locales automáticamente.
# LOCAL_ADMIN_ENABLED=1
# LOCAL_ADMIN_EMAIL=admin@lofthouse14.local
# LOCAL_ADMIN_PASSWORD=lofthouse14
# LOCAL_ADMIN_SECRET=cambia-este-secreto-en-prod


# Multi-tenant (Fase 1) — opcionales; por defecto seed LOFTHOUSE
# DEFAULT_ORGANIZATION_SLUG=lofthouse
# DEFAULT_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111

# Solo servidor — OBLIGATORIO en producción (Droplet) para rutas /api/admin/*,
# usuarios, PMS, crons, etc. Sin esto verás errores en pm2 y el panel fallará.
# SUPABASE_SERVICE_ROLE_KEY=
#
# Opcionales (Drive, Resend, Sentry…): omítelas o déjalas vacías (`VAR=`).
# Un placeholder inválido (ej. email mal formado) rompe `next build` y prod.

# Cron: sincronizar iCal (Vercel Cron → GET /api/cron/sync-ical con Authorization: Bearer …)
# CRON_SECRET=
# Cron: reintentar backup Drive de adjuntos de gastos fallidos → GET /api/cron/expense-drive-retry

# --- Google Drive + Sheets (gastos; solo servidor) ---
# Cuenta de servicio: APIs “Google Drive” + “Google Sheets” habilitadas en GCP.
# Comparte con el e-mail de la cuenta de servicio (Editor):
#   • Carpeta “Comprobantes de Gastos” → GOOGLE_DRIVE_ROOT_FOLDER_ID
#   • Archivo “GASTOS” abierto en Google Sheets → GOOGLE_SHEETS_GASTOS_SPREADSHEET_ID
#     (URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit )
# Si GASTOS está solo como .xlsx en Drive, ábrelo con “Abrir con → Hojas de cálculo”.
#
# La app crea subcarpetas mensuales `AAAA-MM` en Comprobantes y sube archivos como
# `YYYY-MM-DD_{shortId}_{nombre}`. En Sheets añade una fila por gasto en la pestaña
# del mismo mes (FECHA, CATEGORIA, DESCRIPCION, RESPONSABLE, MONTO, MÉTODO DE PAGO, FACTURA).
#
# GOOGLE_CLIENT_EMAIL=bot-gastos@tu-proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Carpeta “Comprobantes de Gastos” (ej. proyecto Lofthouse):
# GOOGLE_DRIVE_ROOT_FOLDER_ID=1s8KMAy3S1iPpYmbL4DYjzTQNFNV_pVnG
# Spreadsheet GASTOS (ID en la URL /d/…/edit):
# GOOGLE_SHEETS_GASTOS_SPREADSHEET_ID=1Q_bkMXFKeGtf0Aa-8OxdcRlcxnYRrOjC

# Opcional: ORM / migraciones SQL directas
# DATABASE_URL=postgresql://...

# --- Sentry (opcional) ---
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# --- Fases 3–11 + backlog integraciones (vacías hasta keys reales) ---
# PAYMENT_PROVIDER=wompi
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_CHECKOUT_BASE_URL=https://checkout.wompi.co/p/
# MERCADOPAGO_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYU_API_KEY=
# PAYU_API_LOGIN=

# WhatsApp Cloud API (Meta) — sin token el runner usa mock
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_BOOKING=
# WHATSAPP_FALLBACK_TO=

# Instagram Graph API (muro /redes) — cuenta Business/Creator vinculada a Meta
# Sin estas vars el sitio usa catálogo local + edición en /admin/redes
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Permalinks extra de reels (coma o salto de línea) si aún no hay token Graph:
# INSTAGRAM_EXTRA_REEL_URLS=https://www.instagram.com/reel/XXXX/
# Cron opcional: GET /api/cron/sync-instagram  Authorization: Bearer $CRON_SECRET

# Email (Resend) — sin key → mock log
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_FALLBACK_TO=

# LLM analytics assistant (sin auto-apply)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# LLM_API_KEY=

# Facturación electrónica CO (stub DIAN / proveedor autorizado)
# EINVOICE_PROVIDER=dian_authorized_stub
# EINVOICE_API_KEY=
# DIAN_API_KEY=

# ADMIN_API_RATE_LIMIT_PER_MINUTE=240
# PUBLIC_API_RATE_LIMIT_PER_MINUTE=60

# --- Persistencia local durable (sin exigir Supabase) ---
# LH_DURABLE_STORE=1
# LH_DATA_DIR=.data

# --- CSRF Origin/Referer (mutaciones admin + public booking) ---
# CSRF_ALLOWED_ORIGINS=https://lofthouse14.com,http://127.0.0.1:43127
# CSRF_STRICT=1
# CSRF_ORIGIN_CHECK=0

# Depósito % (guest mock / políticas)
# BOOKING_DEPOSIT_PERCENT=30
