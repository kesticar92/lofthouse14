# Plantilla: copia a /etc/nginx/sites-available/lofthouse14
# Reemplaza SERVER_NAME por tu dominio o por la IP pública (solo HTTP).
#
# Nota: proxy_buffer_* altos son necesarios porque Next.js envía una CSP
# larga (+ cookies de sesión). Sin esto nginx responde 502
# "upstream sent too big header".

server {
  listen 80;
  listen [::]:80;
  server_name SERVER_NAME;

  proxy_buffer_size 128k;
  proxy_buffers 8 128k;
  proxy_busy_buffers_size 256k;
  large_client_header_buffers 8 64k;

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_cache_bypass $http_upgrade;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }
}
